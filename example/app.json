{
  "expo": {
    "name": "ReactNativeTruecallerExample",
    "slug": "react-native-truecaller-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "../app.plugin.js",
        {
          "androidClientId": "xxxxxxxx-android-client-id"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ajit.reactnativetruecaller.example"
    },
    "android": {
      "package": "ajit.reactnativetruecaller.example",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
